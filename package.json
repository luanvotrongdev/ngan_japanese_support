{
  "name": "ngan-japanese-support",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "DATABASE_URL=data/test.db bun --bun vitest run --no-file-parallelism",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/lib/server/db/migrate.ts"
  },
  "dependencies": {
    "@sveltejs/kit": "2.70.3",
    "drizzle-orm": "0.45.2",
    "svelte": "5.57.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.2",
    "drizzle-kit": "0.31.10",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
